# Copy to .env.local and fill in. Never commit .env.local.

# SQLite file, relative to the project root
DATABASE_URL="file:./prisma/dev.db"

# Public URL of this store (used for Stripe success/cancel redirects)
APP_URL="http://localhost:3000"

# Stripe TEST MODE only (sk_test_...)
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (whsec_...). Optional locally.
STRIPE_WEBHOOK_SECRET=""

# HTTP basic auth for /admin and /api/admin (user: admin)
ADMIN_PASSWORD="admin"

# PayPal (REST app credentials from developer.paypal.com). Use sandbox credentials with PAYPAL_ENV="sandbox".
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Webhook id of the webhook pointing at <APP_URL>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=""
# "sandbox" | "production"
PAYPAL_ENV="sandbox"
